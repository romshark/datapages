package app

import (
	"fmt"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/romshark/datapages/example/realtime-charts/app/datapagesgen/action"
	"github.com/romshark/datapages/example/realtime-charts/app/datapagesgen/assets"
	"github.com/romshark/datapages/example/realtime-charts/app/datapagesgen/href"
	"github.com/romshark/datapages/example/realtime-charts/market"
)

templ head() {
	<title>Realtime Charts</title>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="dark light"/>
	<link rel="icon" type="image/svg+xml" href={ assets.Path("favicon.svg") }/>
	<link rel="stylesheet" href={ assets.Path("style.css") }/>
}

// chartsHead loads the chart library of the chart pages and the module of <rt-chart>,
// which reads the global of the library. The integrity hash pins the file the CDN serves.
templ chartsHead() {
	<script
		src="https://cdn.jsdelivr.net/npm/lightweight-charts@5.2.1/dist/lightweight-charts.standalone.production.js"
		integrity="sha384-KkYqTZlM13Zya6fVUF3IGCBOQ1ehFeJVVgxaVvD/0MebineF9EI8Jkd3NnWNChqN"
		crossorigin="anonymous"
	></script>
	<script type="module" src={ assets.Path("rt-chart.js") }></script>
}

// mapHead loads Apache ECharts, the chart library of the market map, and the module of
// <market-map>, which reads the global of the library.
templ mapHead() {
	<script
		src="https://cdn.jsdelivr.net/npm/echarts@6.1.0/dist/echarts.min.js"
		integrity="sha384-C2iskrW/uPW46KzOjrvJIQo4YkV8lkD+QS0CrDN18IIPIpT/g2USu8bTP3nvmIAD"
		crossorigin="anonymous"
	></script>
	<script type="module" src={ assets.Path("market-map.js") }></script>
}

// portfolioHead loads uPlot, the chart library of the portfolio page, and the module of
// <pf-chart>, which reads the global of the library. A <pf-chart> draws into a shadow
// root, which the stylesheet of uPlot does not reach, and copies the link of the
// stylesheet into it.
templ portfolioHead() {
	<link
		id="uplot-css"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/uplot@1.6.32/dist/uPlot.min.css"
		integrity="sha384-IfV0B7MIOYuO95kO9G5ySKPz/85zqFNOAs8iy4tkK5zd9izhJAB8b7lHrwYqqmYE"
		crossorigin="anonymous"
	/>
	<script
		src="https://cdn.jsdelivr.net/npm/uplot@1.6.32/dist/uPlot.iife.min.js"
		integrity="sha384-Gx3t0zdBAuQOuvvmaLZj7HKEiSgWTAs+VdtNY7wt19QDPTDQjFIwAuXDj0zeN00c"
		crossorigin="anonymous"
	></script>
	<script type="module" src={ assets.Path("pf-chart.js") }></script>
}

// pageView declares the settings signals with the values the page shows. They replace the
// values Datapages seeds from the raw query, which a hand-edited URL can set to something
// the page does not offer.
//
// A phone shows the logo without its name, which fits it into the row of the tabs. The
// media query of the source is the phone breakpoint of the stylesheet.
//
// The live button pauses and resumes the pushes to the tab. Its label says which of the
// two the tab gets, Live or Paused, and its title what a click does. A button whose label
// changes is not a toggle button and has no aria-pressed. Pausing sets the paused signal
// to the second of the charts on screen, which the URL then carries.
//
// The live button and the status keep their width when their text changes, which keeps
// the controls in place. The button holds both labels and hides one. The status holds
// hidden sizers with its widest texts, a pause at a two-digit hour in the morning and in
// the afternoon in the format of the browser.
//
// The navigation bar and the sidebar share a wrapper. On a narrow screen the wrapper
// sticks to the top as one block, which keeps the sidebar below a navigation bar whose
// height depends on how often it wraps.
templ pageView(
	v view, q ViewQuery, ranges []time.Duration, selected []string,
	content templ.Component,
) {
	<div
		id="page"
		class="page"
		data-signals:view={ jsString(string(v)) }
		data-signals:type={ jsString(q.Type) }
		data-signals:refresh={ jsString(q.Refresh) }
		data-signals:range={ jsString(q.Range) }
		data-signals:indexes={ jsString(q.Indexes) }
		data-signals:paused={ strconv.FormatInt(q.Paused, 10) }
		data-signals:sync={ strconv.FormatBool(q.Sync) }
		data-signals:layout={ jsString(q.Layout) }
		data-signals:pushed="0"
	>
		<div class="top">
			<nav class="navbar">
				<h1 class="brand">
					<picture>
						<source
							media="(max-width: 740px)"
							srcset={ assets.Path("logo.svg") }
							width="21"
							height="26"
						/>
						<img
							class="logo"
							src={ assets.Path("logo-full.svg") }
							width="112"
							height="26"
							alt="Datapages"
						/>
					</picture>
					<span class="visually-hidden">Realtime Charts</span>
				</h1>
				@tabs(v, q)
				<div class="controls">
					<div class="control">
						<button
							type="button"
							class={ "live", templ.KV("paused", q.Paused != 0) }
							if q.Paused != 0 {
								title="Resume updates"
							} else {
								title="Pause updates"
							}
							data-class:paused="$paused !== 0"
							data-attr:title="$paused ? 'Resume updates' : 'Pause updates'"
							data-on:click={ action.App.Settings.POST(
								action.WithBefore("$paused = $paused ? 0 : $pushed"),
							) }
						>
							<span class="when-live">Live</span>
							<span class="when-paused">Paused</span>
						</button>
						<select
							data-bind="refresh"
							disabled?={ q.Paused != 0 }
							title="Refresh interval"
							data-attr:disabled="$paused !== 0"
							data-on:change={ action.App.Settings.POST() }
						>
							for _, r := range refreshRates {
								<option value={ r.String() } selected?={ r.String() == q.Refresh }>
									{ r.String() }
								</option>
							}
						</select>
					</div>
					<span class="updated">
						<span
							class="sizer"
							aria-hidden="true"
							data-text="'Paused at ' + new Date(2000, 0, 1, 10).toLocaleTimeString()"
						>
							Paused at 10:00:00 AM
						</span>
						<span
							class="sizer"
							aria-hidden="true"
							data-text="'Paused at ' + new Date(2000, 0, 1, 22).toLocaleTimeString()"
						>
							Paused at 10:00:00 PM
						</span>
						<span
							data-text="$pushed ? ($paused ? 'Paused at ' : 'Updated ') + new Date($pushed * 1000).toLocaleTimeString() : 'Connecting...'"
						>
							Connecting...
						</span>
					</span>
				</div>
			</nav>
			@sidebar(selected)
		</div>
		@errorMessage("")
		<main
			if q.Layout == string(layoutRows) {
				class="rows"
			}
			data-class:rows="$layout === 'rows'"
		>
			@toolbar(v, q, ranges)
			@content
		</main>
		<footer class="footer">
			<a href="https://github.com/romshark/datapages">Datapages</a> demo.
			if v == viewPortfolio {
				Charts by
				<a href="https://github.com/leeoniya/uPlot">uPlot</a>.
			} else if v == viewMap {
				Map by
				<a href="https://echarts.apache.org/">Apache ECharts</a>.
			} else {
				Charts by
				<a href="https://www.tradingview.com/">TradingView</a>
				<a href="https://github.com/tradingview/lightweight-charts">Lightweight Charts&trade;</a>.
			}
		</footer>
	</div>
}

// The chart type and the time range selects redraw the charts, the time range select over
// the ranges the database holds prices for. Both stay enabled while the tab is paused:
// the charts redraw up to the second they are paused at.
//
// On a phone the layout and sync buttons show only their icons, and their names stay in
// the page for assistive technology. The class rows of main sets the layout, not a class
// of the grid, which a morph would reset.
//
// The sync button makes the charts follow the crosshair, the scrolling and the zoom of
// the chart under the pointer. Its name does not change, which makes it a toggle button
// with aria-pressed.
templ toolbar(v view, q ViewQuery, ranges []time.Duration) {
	if v == viewCharts {
		<div class="toolbar">
			<div class="control">
				<select
					data-bind="type"
					title="Chart type"
					data-on:change={ action.App.Settings.POST() }
				>
					for _, t := range chartTypes {
						<option value={ string(t) } selected?={ string(t) == q.Type }>
							{ title(string(t)) }
						</option>
					}
				</select>
				<select
					data-bind="range"
					title="Time range"
					data-on:change={ action.App.Settings.POST() }
				>
					for _, d := range ranges {
						<option value={ rangeName(d) } selected?={ rangeName(d) == q.Range }>
							{ rangeLabel(d) }
						</option>
					}
				</select>
				<div class="segments" role="group" aria-label="Layout">
					@layoutButton(layoutRows, iconRows, q)
					@layoutButton(layoutGrid, iconGrid, q)
				</div>
				<button
					type="button"
					class="sync"
					aria-pressed={ strconv.FormatBool(q.Sync) }
					title="Sync charts"
					data-attr:aria-pressed="$sync ? 'true' : 'false'"
					data-on:click={ action.App.Settings.POST(
						action.WithBefore("$sync = !$sync"),
					) }
				>
					@icon(iconSync)
					<span>Sync</span>
				</button>
			</div>
		</div>
	}
}

templ layoutButton(l layout, svg string, q ViewQuery) {
	<button
		type="button"
		class="segment"
		aria-pressed={ strconv.FormatBool(string(l) == q.Layout) }
		data-attr:aria-pressed={ "$layout === " + jsString(string(l)) + " ? 'true' : 'false'" }
		data-on:click={ action.App.Settings.POST(
			action.WithBefore("$layout = " + jsString(string(l))),
		) }
	>
		@icon(svg)
		<span>{ title(string(l)) }</span>
	</button>
}

// tabs links to the view pages with the settings of the current one. A settings change
// patches them with the new settings. Tabs that do not fit scroll sideways, and the
// current one scrolls into view.
templ tabs(active view, q ViewQuery) {
	<nav
		id="tabs"
		class="tabs"
		aria-label="View"
		data-init="el.querySelector('[aria-current]')?.scrollIntoView({block: 'nearest', inline: 'nearest'})"
	>
		<a
			href={ href.PageIndex(href.QueryPageIndex(q)) }
			class="tab"
			if active == viewCharts {
				aria-current="page"
			}
		>
			@icon(iconCharts)
			Charts
		</a>
		<a
			href={ href.PageMap(href.QueryPageMap(q)) }
			class="tab"
			if active == viewMap {
				aria-current="page"
			}
		>
			@icon(iconMap)
			Map
		</a>
		<a
			href={ href.PagePortfolio(href.QueryPagePortfolio(q)) }
			class="tab"
			if active == viewPortfolio {
				aria-current="page"
			}
		>
			@icon(iconPortfolio)
			Portfolio
		</a>
	</nav>
}

// icon writes svg verbatim, which must be one of the embedded icons such as iconCharts.
templ icon(svg string) {
	@templ.Raw(svg)
}

// sidebar is patched with the new selection after every toggle.
templ sidebar(selected []string) {
	<aside id="sidebar" class="sidebar" aria-label="Indexes">
		<div class="sidebar-header">
			<h2>Indexes</h2>
			<button
				type="button"
				class="select"
				title="Show all indexes"
				disabled?={ len(selected) == len(market.Indexes) }
				data-on:click={ action.App.Select.POST("all") }
			>All</button>
			<button
				type="button"
				class="select"
				title="Hide all indexes"
				disabled?={ len(selected) == 0 }
				data-on:click={ action.App.Select.POST("none") }
			>None</button>
		</div>
		<ul>
			for _, in := range market.Indexes {
				<li>
					<button
						type="button"
						class="index"
						aria-pressed={ strconv.FormatBool(slices.Contains(selected, in.Symbol)) }
						data-on:click={ action.App.Toggle.POST(in.Symbol) }
					>
						<span class="symbol">{ in.Symbol }</span>
						<span class="name">{ in.Name }</span>
					</button>
				</li>
			}
		</ul>
	</aside>
}

// grid is the part of the page that is patched as HTML when the selection, the chart type
// or the time range changes. The bars arrive as signals. The baseline of a baseline chart
// is the price the index opened with, the reference of the change in the card header. The
// IDs of the charts name the chart type and the time range, which makes a morph replace
// the charts of other ones: a new chart starts empty and takes the bars of the new type
// and range.
//
// The button after the name shows while the chart is active and needs no action: a press
// on it is a press outside the chart, which deactivates it.
templ grid(t chartType, cards []card, rng time.Duration) {
	<div id="grid" class="grid">
		if len(cards) == 0 {
			@emptyView("Select indexes in the sidebar to show their charts.")
		}
		for _, c := range cards {
			<article id={ "card-" + c.Symbol } class="card">
				<header class="card-header">
					<div class="ident">
						<span class="symbol">{ c.Symbol }</span>
						<span class="name">{ c.Name }</span>
						<button type="button" class="deactivate" title="Deactivate the chart">
							<svg
								viewBox="0 0 10 10"
								width="10"
								height="10"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<path d="M2.5 2.5l5 5M7.5 2.5l-5 5"></path>
							</svg>
						</button>
					</div>
					<div class="quote">
						<span
							class="price"
							data-text={ feedSignal(c.Index, "price") + " ?? ''" }
						></span>
						<span
							class="change"
							data-text={ feedSignal(c.Index, "change") + " ?? ''" }
							data-class:up={ feedSignal(c.Index, "up") + " === true" }
							data-class:down={ feedSignal(c.Index, "up") + " === false" }
						></span>
					</div>
				</header>
				<rt-chart
					id={ "chart-" + c.Symbol + "-" + string(t) + "-" + rangeName(rng) }
					type={ string(t) }
					bar={ strconv.FormatInt(int64(barOf(rng)/time.Second), 10) }
					base={ price(c.Open) }
					data-effect={ "el.sync = $sync; el.bars = " + feedSignal(c.Index, "bars") }
				></rt-chart>
			</article>
		}
	</div>
}

templ marketMapView() {
	<div id="market" class="market">
		<market-map
			sectors={ mapSectors }
			scale={ strconv.Itoa(mapScale) }
			data-effect="el.data = $_map; el.selection = $indexes"
		></market-map>
		<div class="map-legend" aria-hidden="true">
			<span>{ fmt.Sprintf("-%d%%", mapScale) }</span>
			<span class="map-scale"></span>
			<span>{ fmt.Sprintf("+%d%%", mapScale) }</span>
		</div>
	</div>
}

// portfolio is the part of the portfolio page that is patched as HTML when the holdings
// change. The numbers arrive as signals. The IDs of the charts name the holdings, which
// makes a morph replace the charts of other holdings: a new chart starts empty and takes
// the data of the new ones.
templ portfolio(holdings []string, shares []share) {
	<div id="portfolio" class="portfolio">
		if len(holdings) == 0 {
			@emptyView("Select indexes in the sidebar to build the portfolio.")
		} else {
			<section class="tiles" aria-label="Summary">
				<article class="tile">
					<h2>Value</h2>
					<p class="tile-value" data-text="$_portfolio.value ?? ''"></p>
					<p class="tile-note">
						<span
							data-text="$_portfolio.change?.text ?? ''"
							data-class:up="$_portfolio.change?.up === true"
							data-class:down="$_portfolio.change?.up === false"
						></span>
						since open
					</p>
					<pf-chart
						id={ chartID("spark", holdings) }
						kind="spark"
						span={ windowSpan }
						data-effect="el.data = $_portfolio.returns"
					></pf-chart>
				</article>
				@summaryTile("All indexes", "market")
				@summaryTile("Best", "best")
				@summaryTile("Worst", "worst")
			</section>
			<section class="panels">
				<article class="panel panel-wide">
					<h2>Return since open</h2>
					<pf-chart
						id={ chartID("returns", holdings) }
						kind="lines"
						labels="Portfolio,All indexes"
						unit="%"
						span={ windowSpan }
						data-effect="el.data = $_portfolio.returns"
					></pf-chart>
				</article>
				<article class="panel">
					<h2>Sectors</h2>
					@donut(shares)
				</article>
				<article class="panel">
					<h2>Allocation</h2>
					<pf-chart
						id={ chartID("allocation", holdings) }
						kind="stacked"
						labels={ strings.Join(holdings, ",") }
						unit="%"
						span={ windowSpan }
						data-effect="el.data = $_portfolio.allocation"
					></pf-chart>
				</article>
				<article class="panel">
					<h2>Profit and loss</h2>
					<pf-chart
						id={ chartID("profit", holdings) }
						kind="bars"
						unit="$"
						data-effect="el.data = $_portfolio.profit"
					></pf-chart>
				</article>
				<article class="panel">
					<h2>Drawdown</h2>
					<pf-chart
						id={ chartID("drawdown", holdings) }
						kind="area"
						labels="Drawdown"
						unit="%"
						span={ windowSpan }
						data-effect="el.data = $_portfolio.drawdown"
					></pf-chart>
				</article>
				<article class="panel">
					<h2>Returns per 5-second bar</h2>
					<pf-chart
						id={ chartID("distribution", holdings) }
						kind="histogram"
						unit="%"
						data-effect="el.data = $_portfolio.distribution"
					></pf-chart>
				</article>
			</section>
		}
	</div>
}

templ summaryTile(label, field string) {
	<article class="tile">
		<h2>{ label }</h2>
		<p
			class="tile-value"
			data-text={ "$_portfolio." + field + "?.text ?? ''" }
			data-class:up={ "$_portfolio." + field + "?.up === true" }
			data-class:down={ "$_portfolio." + field + "?.up === false" }
		></p>
		<p class="tile-note" data-text={ "$_portfolio." + field + "?.note ?? ''" }></p>
	</article>
}

// donut draws the shares of the sectors as a ring, each share a dash of one circle, and
// lists them.
templ donut(shares []share) {
	<div class="donut">
		<svg viewBox="-1 -1 2 2" aria-hidden="true">
			<g transform="rotate(-90)">
				for _, s := range shares {
					<circle
						class={ "slice", colorClass(s.Color) }
						r="0.78"
						pathLength="100"
						stroke-dasharray={ fmt.Sprintf("%.3f %.3f", s.Dash, 100-s.Dash) }
						stroke-dashoffset={ fmt.Sprintf("%.3f", -s.Offset) }
					></circle>
				}
			</g>
		</svg>
		<ul>
			for _, s := range shares {
				<li>
					<span class={ "swatch", colorClass(s.Color) }></span>
					{ s.Sector }
					<span class="share">{ fmt.Sprintf("%.0f%%", s.Percent) }</span>
				</li>
			}
		</ul>
	</div>
}

templ emptyView(message string) {
	<div class="empty">
		<div class="desert" aria-hidden="true">
			<div class="tumble">
				<span class="shadow"></span>
				<svg class="tumbleweed" viewBox="-50 -50 100 100">
					<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
						<path d={ tumbleweedOuter } stroke-width="2"></path>
						<path d={ tumbleweedInner } stroke-width="1.4" opacity="0.8"></path>
						<path d={ tumbleweedTwigs } stroke-width="1.6"></path>
					</g>
				</svg>
			</div>
		</div>
		<p>{ message }</p>
		<button
			type="button"
			class="show-all"
			data-on:click={ action.App.Select.POST("all") }
		>Show all indexes</button>
	</div>
}

templ errorMessage(msg string) {
	<p id="error" class="error" role="alert">{ msg }</p>
}

templ pageError(title, detail string) {
	<main class="error-page">
		<h1>{ title }</h1>
		<p>{ detail }</p>
		<a href={ href.PageIndex(href.QueryPageIndex{}) }>Back to the charts</a>
	</main>
}
