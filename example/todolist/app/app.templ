package app

import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/romshark/datapages/example/todolist/app/datapagesgen/action"
	"github.com/romshark/datapages/example/todolist/app/datapagesgen/assets"
	"github.com/romshark/datapages/example/todolist/app/datapagesgen/href"
	"github.com/romshark/datapages/example/todolist/list"
)

// jsStr returns a JSON-encoded string, safe for use in data-signals attributes.
func jsStr(s string) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// formatDue formats a time for the datetime-local input value.
func formatDue(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("2006-01-02T15:04")
}

templ head() {
	<title>Todo List</title>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<link rel="stylesheet" href={ assets.Path("style.css") }/>
}

templ pageIndex(todos []list.Item, search, filter, sortMode string) {
	<div
		id="page-index"
		class="container"
		data-signals:search={ jsStr(search) }
		data-signals:filter={ jsStr(filter) }
		data-signals:sort={ jsStr(sortMode) }
		data-signals:show-modal="false"
		data-signals:new-title="''"
		data-signals:new-desc="''"
		data-signals:new-due="''"
	>
		<h1>Todo List</h1>
		<div class="toolbar">
			<input
				type="text"
				aria-label="Search"
				placeholder="Search..."
				data-bind="search"
				data-indicator:_searching
				data-on:input__debounce.200ms={ action.PageIndex.Filter.POST() }
			/>
			<select
				aria-label="Show"
				data-bind="filter"
				data-indicator:_filtering
				data-on:change={ action.PageIndex.Filter.POST() }
			>
				// selected shows the value before Datastar binds the signal.
				<option value="all" selected?={ filter == "all" }>All</option>
				<option value="done" selected?={ filter == "done" }>Done</option>
				<option value="pending" selected?={ filter == "pending" }>Pending</option>
			</select>
			<select
				aria-label="Sort by"
				data-bind="sort"
				data-indicator:_sorting
				data-on:change={ action.PageIndex.Filter.POST() }
			>
				<option value="alpha" selected?={ sortMode == "alpha" }>Alphabetical</option>
				<option value="created" selected?={ sortMode == "created" }>Created</option>
				<option value="due" selected?={ sortMode == "due" }>Due Date</option>
			</select>
			<button class="btn-primary" data-on:click="$showModal=true">
				+ New Todo
			</button>
		</div>
		@todoList(todos)
		<div class="modal-overlay" style="display:none" data-show="$showModal">
			<div
				class="modal"
				role="dialog"
				aria-modal="true"
				aria-labelledby="new-todo-heading"
			>
				<h2 id="new-todo-heading">New Todo</h2>
				<label for="new-title">Title</label>
				<input
					id="new-title"
					type="text"
					data-bind="newTitle"
					placeholder="What needs to be done?"
				/>
				<label for="new-desc">Description</label>
				<textarea
					id="new-desc"
					data-bind="newDesc"
					placeholder="Details..."
				></textarea>
				<label for="new-due">Due Date</label>
				<input id="new-due" type="datetime-local" data-bind="newDue"/>
				<div class="modal-actions">
					<button
						data-on:click="
							$showModal=false;$newTitle='';$newDesc='';$newDue=''
						"
					>
						Cancel
					</button>
					<button
						class="btn-primary"
						data-on:click={ action.PageIndex.Create.POST(
							action.WithAfter(
								"$showModal=false;$newTitle='';$newDesc='';$newDue=''",
							),
						) }
					>
						Create
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ todoList(todos []list.Item) {
	// Each control has its own indicator signal. A shared one would turn
	// false when the first of 2 overlapping requests finishes.
	<div
		id="todo-list"
		data-class:loading="$_searching || $_filtering || $_sorting"
	>
		if len(todos) == 0 {
			<p class="empty">No todos found.</p>
		} else {
			<ul class="todo-rows" aria-label="Todos">
				@todoRows(todos)
			</ul>
		}
	</div>
}

templ todoRows(todos []list.Item) {
	for _, t := range todos {
		<li id={ "todo-" + t.ID } class={ "todo-row", templ.KV("done", t.Done) }>
			// The checkbox id includes the done state so that the morph
			// replaces the element instead of patching it in place.
			// Patching only updates the HTML checked attribute, not the
			// DOM checked property, leaving the checkbox visually stale.
			//
			// Signals are page-global.
			// The todo ID in the signal path gives each row its own indicator.
			<span class="check" data-class:loading={ "$_toggling." + t.ID }>
				<input
					id={ fmt.Sprintf("check-%s-%t", t.ID, t.Done) }
					type="checkbox"
					aria-label={ t.Title }
					if t.Done {
						checked
					}
					data-indicator={ "_toggling." + t.ID }
					data-on:click={ action.App.Toggle.PUT(t.ID) }
				/>
			</span>
			<a href={ href.PageItem(t.ID) } class="todo-content">
				<span class="todo-title">{ t.Title }</span>
				if t.Description != "" {
					<span class="todo-desc">{ t.Description }</span>
				}
			</a>
			if !t.DueAt.IsZero() {
				<span class="due">Due by { t.DueAt.Format("Jan 2, 15:04") }</span>
			}
		</li>
	}
}

templ pageItem(todo list.Item) {
	<div
		id="page-item"
		class="container"
		data-signals:item-id={ jsStr(todo.ID) }
		data-signals:title={ jsStr(todo.Title) }
		data-signals:description={ jsStr(todo.Description) }
		data-signals:done={ fmt.Sprintf("%t", todo.Done) }
		data-signals:due={ jsStr(formatDue(todo.DueAt)) }
	>
		<a href={ href.PageIndex(href.QueryPageIndex{}) } class="back">
			&larr; Back to list
		</a>
		@itemTitle(todo)
		<div class="form">
			<label for="edit-title" data-class:saving="$_savingTitle">Title</label>
			<input
				id="edit-title"
				type="text"
				data-bind="title"
				data-indicator:_saving-title
				data-on:input__debounce.200ms={ action.PageItem.Edit.PUT(todo.ID) }
			/>
			<label
				for="edit-description"
				data-class:saving="$_savingDescription"
			>Description</label>
			<textarea
				id="edit-description"
				data-bind="description"
				data-indicator:_saving-description
				data-on:input__debounce.200ms={ action.PageItem.Edit.PUT(todo.ID) }
			></textarea>
			<label class="checkbox-label">
				<span class="check" data-class:loading="$_savingDone">
					<input
						type="checkbox"
						data-bind="done"
						data-indicator:_saving-done
						data-on:change={ action.PageItem.Edit.PUT(todo.ID) }
					/>
				</span>
				Done
			</label>
			<label for="edit-due" data-class:saving="$_savingDue">Due Date</label>
			<input
				id="edit-due"
				type="datetime-local"
				data-bind="due"
				data-indicator:_saving-due
				data-on:change={ action.PageItem.Edit.PUT(todo.ID) }
			/>
			<p class="created">
				Created: { todo.CreatedAt.Format("Jan 2, 2006 15:04") }
			</p>
			<button
				class="btn-danger"
				data-on:click={ action.PageItem.Item.DELETE(todo.ID) }
			>
				Delete
			</button>
		</div>
	</div>
}

templ itemTitle(todo list.Item) {
	<h1 id="item-title">{ todo.Title }</h1>
}
