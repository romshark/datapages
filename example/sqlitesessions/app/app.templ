package app

import (
	"github.com/romshark/datapages/example/sqlitesessions/datapagesgen/action"
	"github.com/romshark/datapages/example/sqlitesessions/datapagesgen/href"
)

templ head() {
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<style>
		:root { color-scheme: dark; }
		body {
			font-family: sans-serif;
			max-width: 34rem;
			margin: 3rem auto;
			padding: 0 1.25rem 3rem;
			line-height: 1.55;
			color: #e5e7eb;
			background: #0b0f17;
		}
		a {
			color: #5eead4;
		}
		nav {
			display: flex;
			gap: 1rem;
			align-items: center;
			margin-bottom: 2rem;
		
			& a, & button.linklike {
				color: #0f766e;
				text-decoration: none;
				font-weight: 600;
				background: none;
				border: 0;
				padding: 0;
				font: inherit;
				cursor: pointer;
			}
		
			& a:hover, & button.linklike:hover {
				text-decoration: underline;
			}
		}
		h1 {
			font-size: 1.65rem;
			margin: 0 0 1rem;
		}
		h2 {
			font-size: 1.1rem;
			margin: 1.5rem 0 0.5rem;
		}
		.card {
			padding: 1.5rem;
			border: 1px solid #1f2937;
			border-radius: 0.75rem;
			background: #111827;
		}
		.field {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin: 0.75rem 0;
		}
		label {
			font-size: 0.8rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}
		input {
			padding: 0.6rem 0.75rem;
			border: 1px solid #374151;
			border-radius: 0.5rem;
			background: #0b0f17;
			color: #e5e7eb;
			font: inherit;
		}
		input::placeholder {
			color: #6b7280;
		}
		button.primary {
			padding: 0.65rem 1.25rem;
			border: 0;
			border-radius: 0.5rem;
			background: #0f766e;
			color: white;
			font-weight: 600;
			font-size: 0.95rem;
			cursor: pointer;
			
			&:disabled {
				opacity: 0.5; cursor: not-allowed;
			}
			&:hover:not(:disabled) {
				background: #115e59;
			}
		}
		button.danger {
			padding: 0.5rem 1rem;
			border: 1px solid #fecaca;
			border-radius: 0.5rem;
			background: transparent;
			color: #b91c1c;
			font-weight: 600;
			font: inherit;
			cursor: pointer;
		}
		.error {
			color: #b91c1c;
			font-size: 0.9rem;
			margin: 0.5rem 0;
		}
		.muted {
			color: #94a3b8;
			font-size: 0.9rem;
		}
		code {
			background: rgba(127, 127, 127, 0.15);
			padding: 0.1rem 0.35rem;
			border-radius: 0.25rem; font-size: 0.9em;
		}
	</style>
}

templ nav(session Session) {
	<nav>
		<a href={ href.PageIndex() }>Home</a>
		if session.UserID != "" {
			<button
				class="linklike"
				data-on:click={ action.POSTAppSignOut() }
			>Sign Out</button>
		} else {
			<a href={ href.PageLogin() }>Login</a>
			<a href={ href.PageRegister() }>Register</a>
		}
	</nav>
}

templ pageIndexHead() {
	<title>Home</title>
}

templ pageIndex(session Session, users []User) {
	@nav(session)
	if session.UserID != "" {
		<h1>Hello, <b>{ session.Name }</b></h1>
		<p>Signed in as <strong>{ session.Email }</strong>.</p>
	} else {
		<h1>Hello, dear guest</h1>
		<p>You're not signed in.</p>
	}
	<h2>Registered users</h2>
	if len(users) == 0 {
		<p class="muted">
			No users yet — be the first to
			<a href={ href.PageRegister() }>register</a>.
		</p>
	} else {
		<ul>
			for _, u := range users {
				<li>
					<strong>{ u.Name }</strong> — { u.Email }
					if u.ID == session.UserID {
						(that's you)
					}
				</li>
			}
		</ul>
	}
}

templ pageLoginHead() {
	<title>Login</title>
}

templ pageLogin(errorMsg string, valid bool) {
	@nav(Session{})
	<form
		class="card"
		data-signals:email="''"
		data-signals:password="''"
		data-on:input__debounce.300ms={ action.POSTPageLoginValidate() }
		data-on:submit__prevent={ action.POSTPageLoginSubmit() }
	>
		<h1>Login</h1>
		<div class="field">
			<label for="elEmail">Email</label>
			<input
				id="elEmail"
				type="email"
				data-bind="email"
				placeholder="you@example.com"
				autocomplete="email"
				data-ignore-morph
			/>
		</div>
		<div class="field">
			<label for="elPass">Password</label>
			<input
				id="elPass"
				type="password"
				data-bind="password"
				placeholder="••••••••"
				autocomplete="current-password"
				data-ignore-morph
			/>
		</div>
		if errorMsg != "" {
			<p class="error">{ errorMsg }</p>
		}
		<button class="primary" type="submit" disabled?={ !valid }>Sign in</button>
		<p class="muted" style="margin-top:1rem">
			New here? <a href={ href.PageRegister() }>Create an account</a>.
		</p>
	</form>
}

templ pageRegisterHead() {
	<title>Register</title>
}

templ pageRegister(errorMsg string, valid bool) {
	@nav(Session{})
	<form
		class="card"
		data-signals:name="''"
		data-signals:email="''"
		data-signals:password="''"
		data-on:input__debounce.300ms={ action.POSTPageRegisterValidate() }
		data-on:submit__prevent={ action.POSTPageRegisterSubmit() }
	>
		<h1>Create account</h1>
		<div class="field">
			<label for="elNameR">Name</label>
			<input
				id="elNameR"
				type="text"
				data-bind="name"
				placeholder="Ada Lovelace"
				autocomplete="name"
				data-ignore-morph
			/>
		</div>
		<div class="field">
			<label for="elEmailR">Email</label>
			<input
				id="elEmailR"
				type="email"
				data-bind="email"
				placeholder="you@example.com"
				autocomplete="email"
				data-ignore-morph
			/>
		</div>
		<div class="field">
			<label for="elPassR">Password</label>
			<input
				id="elPassR"
				type="password"
				data-bind="password"
				placeholder="min 8 characters"
				autocomplete="new-password"
				data-ignore-morph
			/>
		</div>
		if errorMsg != "" {
			<p class="error">{ errorMsg }</p>
		}
		<button class="primary" type="submit" disabled?={ !valid }>Register</button>
		<p class="muted" style="margin-top:1rem">
			Already have an account? <a href={ href.PageLogin() }>Log in</a>.
		</p>
	</form>
}
