.PHONY: dev up down build gen lint{{if .TypeScript}} npm-install bundle{{end}}

dev: up{{if .TypeScript}} bundle{{end}}
	datapages watch

up:
	docker compose up -d

down:
	docker compose down

build:{{if .Hidden}} gen{{end}}{{if .TypeScript}} bundle{{end}}
	go build -o ./cmd/server/server ./cmd/server/

gen:
{{- if .Hidden}}
	go run {{.TemplCmd}} generate
{{- end}}
	datapages gen

lint:
	go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest run ./...
{{- if .TypeScript}}

npm-install:
	cd web && npm install

# Bundles the Web Components of web/src into app/static/components.js.
bundle:
	cd web && node build.mjs
{{- end}}
