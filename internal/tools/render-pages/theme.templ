package main

import "github.com/romshark/morpheus/neo"

// themeScript applies the theme chosen with [themeSwitch] or [themeSelect] and
// marks the choice in both. It runs in <head>, which sets the theme before the
// first paint. Without a choice the stylesheet follows the system theme.
templ themeScript() {
	<script>
		(() => {
			const root = document.documentElement;
			const stored = () => {
				try {
					return localStorage.getItem("theme");
				} catch {
					return null;
				}
			};
			const apply = (choice) => {
				if (choice === "light" || choice === "dark") {
					root.dataset.theme = choice;
				} else {
					delete root.dataset.theme;
				}
				const current = root.dataset.theme ?? "system";
				for (const b of document.querySelectorAll("[data-theme-choice]")) {
					b.setAttribute("aria-pressed", String(b.dataset.themeChoice === current));
				}
				// The attribute, because the select may not be upgraded yet.
				for (const select of document.querySelectorAll("neo-select.theme-select")) {
					select.setAttribute("value", current);
				}
			};
			const choose = (choice) => {
				try {
					if (choice === "system") {
						localStorage.removeItem("theme");
					} else {
						localStorage.setItem("theme", choice);
					}
				} catch {}
				apply(choice);
			};
			apply(stored());
			document.addEventListener("DOMContentLoaded", () => apply(stored()));
			document.addEventListener("click", (e) => {
				const button = e.target.closest("[data-theme-choice]");
				if (button) {
					choose(button.dataset.themeChoice);
				}
			});
			document.addEventListener("neo-select-change", (e) => {
				if (e.target.matches(".theme-select")) {
					choose(e.detail.value);
				}
			});
		})();
	</script>
}

// themeSwitch lets the visitor choose the system, the light or the dark theme.
templ themeSwitch() {
	<div class="theme-switch" role="group" aria-label="Theme">
		<button type="button" data-theme-choice="system" aria-pressed="true" aria-label="System theme" title="System theme">
			@iconDesktop()
		</button>
		<button type="button" data-theme-choice="light" aria-pressed="false" aria-label="Light theme" title="Light theme">
			@iconSun()
		</button>
		<button type="button" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark theme">
			@iconMoon()
		</button>
	</div>
}

// themeSelect is the theme switch of a documentation page on a narrow screen.
// Its trigger shows the icon of the chosen theme.
templ themeSelect() {
	@neo.SelectAttrs(neo.SelectOpts{
		Value:             neo.Set("system"),
		Size:              neo.Set("sm"),
		AriaLabel:         neo.Set("Theme"),
		Caret:             neo.Set(""),
		Placement:         neo.Set(neo.PlacementBottomEnd),
		PopoverFitContent: neo.Set(true),
	}, templ.Attributes{"class": "theme-select", "title": "Theme"}) {
		@themeOption("system", "System") {
			@iconDesktop()
		}
		@themeOption("light", "Light") {
			@iconSun()
		}
		@themeOption("dark", "Dark") {
			@iconMoon()
		}
	}
}

// themeOption is the option of [themeSelect] for the theme choice. It shows the
// children, an icon, before the label, and only the icon on the trigger.
templ themeOption(choice, label string) {
	@neo.Option(neo.OptionOpts{Value: neo.Set(choice), Label: neo.Set(label)}) {
		@neo.OptionTrigger() {
			{ children... }
		}
		{ children... }
		{ label }
	}
}
